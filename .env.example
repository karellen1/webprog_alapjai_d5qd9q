# Copy this file to .env for local development.
# Do not commit .env (already ignored).

POSTGRES_DB=notesappdb
POSTGRES_USER=notesapp
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432
API_PORT=5098
FRONTEND_PORT=5173

# JWT settings (used by setup-user-secrets script)
JWT__Key=CHANGE_ME_LONG_RANDOM_STRING_MIN_32_CHARS
JWT__Issuer=NotesApp
JWT__Audience=NotesApp.Client

# Backend runtime DB connection (optional if you use dotnet user-secrets instead)
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=notesappdb;Username=notesapp;Password=CHANGE_ME_STRONG_PASSWORD
